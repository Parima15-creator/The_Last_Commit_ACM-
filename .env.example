# Backend
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Groq API (Required for AI receipt vision & voice parsing)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_API_TIMEOUT=30000

# Database
DATABASE_URL=./server/data/jholfree.json

# Authentication MySQL database (XAMPP defaults: root user, blank password)
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_NAME=jholfree_auth
AUTH_DB_USER=root
AUTH_DB_PASSWORD=
AUTH_OTP_TTL_SECONDS=300
AUTH_SESSION_DAYS=7

# Google OAuth (optional until Google sign-in is configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Authentication (optional)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Email notifications (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# SMS notifications (optional)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Application
APP_NAME=JholFree
APP_URL=http://localhost:5173

# UPI Defaults
UPI_DEFAULT_ID=user@upi
UPI_DEFAULT_NAME=JholFree User
