# Copy this file to .env and update the values for your machine.

# Backend
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Groq API (Required for AI receipt vision & voice parsing)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_API_TIMEOUT=30000

# Database
DATABASE_URL=./server/data/jholfree.json

# Authentication MySQL database
# XAMPP defaults are host 127.0.0.1, port 3306, user root, blank password.
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_NAME=jholfree_auth
AUTH_DB_USER=root
AUTH_DB_PASSWORD=
AUTH_DB_TIMEZONE=+05:30
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_SESSION_DAYS=7

# SMTP email OTP (no third-party API or SMS app required)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS OTP delivery through Twilio (server-side; users receive a normal SMS)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Google OAuth (optional; required only for the Google sign-in button)
# Add the same callback URL in Google Cloud Console:
# http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Default UPI profile
UPI_DEFAULT_ID=user@upi
UPI_DEFAULT_NAME=JholFree User
